[Unit]
Description=omp-tg Telegram gateway for OMP
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=90
TimeoutStartSec=30
User=omp
Group=omp
EnvironmentFile=/etc/omp-tg/env
Environment=OMP_BIN=/home/omp/.local/bin/omp
Environment=OMP_WORKDIR=/home/omp/workspace
Environment=OMP_SESSION_ROOT=/home/omp/.omp/tg-sessions
Environment=OMP_SPAWN_MODE=systemd-user-scope
Environment=LOG_LEVEL=info
Environment=HEALTH_PORT=8766
Environment=STT_ENABLED=true
Environment=STT_URL=http://127.0.0.1:8765
Environment=STT_LANGUAGE=ru
Environment=STT_TIMEOUT_MS=300000
Environment=TTS_ENABLED=true
Environment=TTS_URL=http://127.0.0.1:8767
Environment=TTS_MAX_CHARS=1500
Environment=TTS_TIMEOUT_MS=120000
ExecStart=/opt/omp-tg/bin/omp-tg
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
StateDirectory=omp-tg
RuntimeDirectory=omp-tg
ReadWritePaths=/home/omp/.omp /home/omp/workspace
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
MemoryMax=512M
CPUQuota=100%
