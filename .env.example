TELEGRAM_BOT_TOKEN=
OMP_ENDPOINT=spawn
ALLOWED_USER_IDS=
IDLE_TIMEOUT_MS=1800000
THROTTLE_MS=1200
OMP_BIN=/home/omp/.local/bin/omp
OMP_WORKDIR=/home/omp/workspace
OMP_SESSION_ROOT=/home/omp/.omp/tg-sessions
OMP_SPAWN_MODE=direct
MAX_ACTIVE_SESSIONS=4
OMP_START_TIMEOUT_MS=30000
OMP_REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
# OMP_UPLOAD_DIR defaults to $OMP_WORKDIR/.omp-tg-uploads
TELEGRAM_REQUIRE_MENTION=false
TELEGRAM_MENTION_PATTERNS=
TELEGRAM_GROUP_ALLOWED_CHATS=
TELEGRAM_REACTIONS=true
TELEGRAM_DROP_PENDING_UPDATES=true
TELEGRAM_SILENT_PROGRESS=true
TELEGRAM_COMMAND_MENU=true
STT_ENABLED=false
STT_URL=http://127.0.0.1:8765
STT_LANGUAGE=
STT_TIMEOUT_MS=120000
TTS_ENABLED=false
TTS_URL=http://127.0.0.1:8767
TTS_TIMEOUT_MS=120000
TTS_MAX_CHARS=1500
OMP_MEMORY_MAX=2G
OMP_MEMORY_SWAP_MAX=512M
OMP_TASKS_MAX=512
OMP_CPU_QUOTA=200%
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8766
RETENTION_UPLOAD_DAYS=14
RETENTION_EXPORT_DAYS=14
SESSION_RETENTION_DAYS=0
